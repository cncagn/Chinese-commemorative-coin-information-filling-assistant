{
  "manifest_version": 3,
  "name": "中国农业银行纪念币预约填写助手",
  "version": "1.1.0",
  "description": "仅用于中国农业银行纪念币预约页面的本地信息填写扩展",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://eapply.abchina.com/*"],
  "action": {
    "default_popup": "1.html",
    "default_title": "中国农业银行纪念币预约填写助手"
  },
  "content_scripts": [
    {
      "matches": ["https://eapply.abchina.com/*"],
      "js": ["2.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["3.html", "3.css", "3.js", "sxnx.png", "logo.png"],
      "matches": ["https://eapply.abchina.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_policy": "script-src 'self'; object-src 'self';"
  },
  "author": "CNCAGN（基于 DYexb 原项目修改）"
}
